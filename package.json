{
    "name": "react-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "javascript.suggest.paths": true,
    "typescript.suggest.paths": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "server": "json-server --watch src/db.json -p 8800",
        "server:help": "json-server --help",
        "start:app": "concurrently \"npm run server\" \"npm run dev\"",
        "types:check": "tsc --noEmit -project tsconfig.app.json",
        "prepare": "husky"
    },
    "dependencies": {
        "eslint-plugin-prettier": "^5.5.6",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.1",
        "react-toastify": "^11.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "json-server": "^1.0.0-beta.15",
        "prettier": "3.9.6",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    }
}
